# Environment Configuration for Recommendation API

# MongoDB Configuration (Production)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=social_media
MONGODB_POSTS_COLLECTION=posts
MONGODB_USERS_COLLECTION=users

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# FAISS Configuration
EMBEDDING_DIMENSION=384
TOP_K_CANDIDATES=30
FINAL_RECOMMENDATIONS=10

# Scoring Weights
CATEGORY_WEIGHT=0.5
ENGAGEMENT_WEIGHT=0.3
RECENCY_WEIGHT=0.2

# Data Paths (Development/Testing)
DATA_DIR=../MODEL
POSTS_FILE=posts.json
USERS_FILE=users.json

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
